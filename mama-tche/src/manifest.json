  "paroles": [
    {
      "debut": 0.0,
      "fin": 3.8,
      "texte": "Wolof TechStein beat wê!",
      "style": "HookGold",
      "section": "intro"
    },
    {
      "debut": 4.2,
      "fin": 13.6,
      "texte": "Non vivi o - o nvi gboon mavomavo.",
      "style": "IntroSerif",
      "section": "intro"
    },
    {
      "debut": 14.0,
      "fin": 17.0,
      "texte": "Hwenu e mon non ji gbonton o ji",
      "style": "VerseMono",
      "section": "verse1"
    },
    {
      "debut": 20.0,
      "fin": 23.9,
      "texte": "Before the world could call my name",
      "style": "VerseMono",
      "section": "verse1"
    },
    {
      "debut": 23.9,
      "fin": 27.9,
      "texte": "Le jour où tu m'as tenu dans tes bras",
      "style": "VerseMono",
      "section": "verse1"
    },
    {
      "debut": 27.9,
      "fin": 31.0,
      "texte": "You already knew my soul",
      "style": "VerseMono",
      "section": "verse1"
    },
    {
      "debut": 31.0,
      "fin": 35.0,
      "texte": "Azoon lon bo - wo a toln kpo",
      "style": "VerseMono",
      "section": "verse1"
    },
    {
      "debut": 35.0,
      "fin": 37.0,
      "texte": "Every storm, you stood in the rain",
      "style": "VerseMono",
      "section": "verse1"
    },
    {
      "debut": 37.0,
      "fin": 41.9,
      "texte": "Toutes les nuits - tu as veillé",
      "style": "VerseMono",
      "section": "verse1"
    },
    {
      "debut": 41.9,
      "fin": 45.0,
      "texte": "So I could stay warm, so I could remain",
      "style": "VerseMono",
      "section": "verse1"
    },
    {
      "debut": 45.0,
      "fin": 48.0,
      "texte": "Non vivi o - a non da nu mi",
      "style": "VerseMono",
      "section": "verse1"
    },
    {
      "debut": 48.0,
      "fin": 52.0,
      "texte": "Ton amour - tu me l'as donné",
      "style": "VerseMono",
      "section": "verse1"
    },
    {
      "debut": 52.0,
      "fin": 54.0,
      "texte": "No words can hold what you gave",
      "style": "VerseMono",
      "section": "verse1"
    },
    {
      "debut": 54.0,
      "fin": 58.0,
      "texte": "A love too wide, too deep for the grave",
      "style": "VerseMono",
      "section": "verse1"
    },
    {
      "debut": 58.0,
      "fin": 62.0,
      "texte": "Mama tche - you are my one",
      "style": "RefrainGold",
      "section": "refrain1"
    },
    {
      "debut": 62.0,
      "fin": 65.0,
      "texte": "Mama tche - my only sun",
      "style": "RefrainGold",
      "section": "refrain1"
    },
    {
      "debut": 65.0,
      "fin": 68.0,
      "texte": "Gboon ce o - tu es ma vie",
      "style": "RefrainGold",
      "section": "refrain1"
    },
    {
      "debut": 68.0,
      "fin": 72.0,
      "texte": "Ma mère unique - forever with me",
      "style": "RefrainGold",
      "section": "refrain1"
    },
    {
      "debut": 72.0,
      "fin": 76.0,
      "texte": "Even if the sky forgets my name",
      "style": "RefrainGold",
      "section": "refrain1"
    },
    {
      "debut": 76.0,
      "fin": 80.0,
      "texte": "Even if I'm lost, you guide my way",
      "style": "RefrainGold",
      "section": "refrain1"
    },
    {
      "debut": 80.0,
      "fin": 86.0,
      "texte": "Mama tche - mi non no fi",
      "style": "RefrainGold",
      "section": "refrain1"
    },
    {
      "debut": 86.0,
      "fin": 90.0,
      "texte": "I hear you say - I'm here, I'll stay",
      "style": "RefrainGold",
      "section": "refrain1"
    },
    {
      "debut": 90.0,
      "fin": 94.0,
      "texte": "Hwenu e a yi - nyi ma se o",
      "style": "VerseSans",
      "section": "verse2"
    },
    {
      "debut": 94.0,
      "fin": 97.0,
      "texte": "The silence you left was a kind of sound",
      "style": "VerseSans",
      "section": "verse2"
    },
    {
      "debut": 97.0,
      "fin": 101.0,
      "texte": "Le jour où tu es partie - je n'entendais pas",
      "style": "VerseSans",
      "section": "verse2"
    },
    {
      "debut": 101.0,
      "fin": 104.0,
      "texte": "Like a bell that rings with no one around",
      "style": "VerseSans",
      "section": "verse2"
    },
    {
      "debut": 104.0,
      "fin": 107.8,
      "texte": "Non e a do mi - o non no nyi mon",
      "style": "VerseSans",
      "section": "verse2"
    },
    {
      "debut": 107.8,
      "fin": 111.0,
      "texte": "In every choice, in every step I take",
      "style": "VerseSans",
      "section": "verse2"
    },
    {
      "debut": 111.0,
      "fin": 115.0,
      "texte": "Ce que tu m'as laissé - vit encore en moi",
      "style": "VerseSans",
      "section": "verse2"
    },
    {
      "debut": 115.0,
      "fin": 118.0,
      "texte": "I carry your heart - it will never break",
      "style": "VerseSans",
      "section": "verse2"
    },
    {
      "debut": 118.0,
      "fin": 122.0,
      "texte": "Non vivi o - o ku kpoonon",
      "style": "VerseSans",
      "section": "verse2"
    },
    {
      "debut": 122.0,
      "fin": 125.0,
      "texte": "Ton amour - il ne meurt jamais",
      "style": "VerseSans",
      "section": "verse2"
    },
    {
      "debut": 125.0,
      "fin": 128.0,
      "texte": "Death could not take what you gave",
      "style": "VerseSans",
      "section": "verse2"
    },
