      395,
      1780,
      685
    ],
    "lines": [
      "Do sourou, patience,",
      "le succès vient ce soir"
    ],
    "word_count": 8
  },
  {
    "text": "Damlon, dors tranquille, j'gère tout, j'suis debout",
    "font_size": 128,
    "bbox": [
      140,
      394,
      1780,
      686
    ],
    "lines": [
      "Damlon, dors tranquille,",
      "j'gère tout, j'suis debout"
    ],
    "word_count": 7
  },
  {
    "text": "Monwê, c'est cela même, j'avance malgré tout",
    "font_size": 128,
    "bbox": [
      140,
      394,
      1780,
      686
    ],
    "lines": [
      "Monwê, c'est cela même,",
      "j'avance malgré tout"
    ],
    "word_count": 7
  },
  {
    "text": "Mansékpon, jamais entendu parler d'ça",
    "font_size": 128,
    "bbox": [
      140,
      394,
      1780,
      686
    ],
    "lines": [
      "Mansékpon, jamais",
      "entendu parler d'ça"
    ],
    "word_count": 5
  },
  {
    "text": "Mais j'le vis, j'le vis, j'le vis, crois-moi",
    "font_size": 128,
    "bbox": [
      140,
      394,
      1780,
      686
    ],
    "lines": [
      "Mais j'le vis, j'le vis,",
      "j'le vis, crois-moi"
    ],
    "word_count": 8
  },
  {
    "text": "Dokpè nou mahou nou kpèè or, j'remercie pour le peu",
    "font_size": 128,
