      1211
    ],
    "lines": [
      "Do sourou,",
      "patience, le",
      "succès vient",
      "ce soir"
    ],
    "word_count": 8
  },
  {
    "text": "Damlon, dors tranquille, j'gère tout, j'suis debout",
    "font_size": 112,
