      "j'ai appris à les dompter"
    ],
    "word_count": 10
  },
  {
    "text": "Djidjan yi, assoie-toi, écoute mon histoire",
    "font_size": 128,
    "bbox": [
      140,
      394,
      1780,
      686
    ],
    "lines": [
